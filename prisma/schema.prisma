generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String    @default("")
  firstName            String
  lastName             String
  isActive             Boolean   @default(true)
  role                 String    @default("Member")
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  travels              Travel[]

  @@map("users")
}

model Travel {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean  @default(false)
  coverId     Int?     @unique
  cover       Media?   @relation("TravelCover", fields: [coverId], references: [id], onDelete: SetNull)
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  medias      Media[]  @relation("TravelMedias")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("travels")
}

model Media {
  id          Int       @id @default(autoincrement())
  url         String
  key         String
  mimeType    String
  size        Int
  takenAt     DateTime?
  lat         Float?
  lng         Float?
  place       String?
  description String?
  city        String?
  region      String?
  state       String?
  countryCode String?
  travelId    Int
  travel      Travel    @relation("TravelMedias", fields: [travelId], references: [id], onDelete: Cascade)
  coverOf     Travel?   @relation("TravelCover")
  createdAt   DateTime  @default(now())

  @@map("medias")
}
